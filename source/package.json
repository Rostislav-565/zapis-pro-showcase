{
  "name": "zapis-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.14.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "migrate": "node server/db.ts",
    "seed": "node server/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node server/start.ts",
    "verify": "node --test scripts/api.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
