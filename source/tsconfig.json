{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "jsx": "react-jsx", "skipLibCheck": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["web", "server", "shared", "scripts", "vite.config.ts"]
}
